#!/usr/bin/env bash
# Pre-push hook — fail-closed watermark scan over the exact pushed commit
# range. Ported from savant-code (FID-20260909-036).
#
# GitHub converts Co-Authored-By trailers into contributor credit, so any
# commit message carrying an unauthorized coding-agent trailer must never
# reach the remote — even from a clone that bypassed commit-msg with
# --no-verify. The scan runs per-commit across the pushed range and refuses
# the push on the first watermarked message.
#
# This repo's node/npm toolchain is used instead of savant-code's bun gates:
# the watermark scan is pure git + grep, so it stays fail-closed without
# requiring a runtime dependency. (Secret/credential scanning per-push can be
# layered on later; the attribution guard is the ported contract.)

set -uo pipefail

# ---- Gate 1: inverted route census (FID-20260917-007, gate-wired 2026-09-17) ----
# Every client fetch URL must resolve to an existing app/api route, so the
# called-but-never-built class ("Failed to load clan data", FID-20260917-006)
# can no longer merge silently. Fail-closed on MISSING and UNPARSED alike —
# an unparsable call site is unverified, not clean. Always runs (it is ~0.7s):
# the census catches both directions — new calls to missing routes AND route
# deletions that orphan existing callers. It scans the worktree, which under a
# normal push is exactly the to-be-pushed tip.
echo "🔍 pre-push: inverted route census (called-but-never-built gate)..."
census_out="$(node scripts/invertedRouteCensus.cjs 2>&1)"
census_status=$?
if [ "$census_status" -ne 0 ]; then
  echo "$census_out" | tail -n 30 >&2
  echo "❌ pre-push: census refused the push (exit ${census_status}) — fix the" >&2
  echo "   MISSING/UNPARSED call sites above or add a documented WAIVER in" >&2
  echo "   scripts/invertedRouteCensus.cjs (full report: node scripts/invertedRouteCensus.cjs)." >&2
  exit 1
fi
echo "✅ pre-push: census clean ($(printf '%s' "$census_out" | head -n 1))"

# ---- Gate 3: Mongo shim runtime census (FID-20260917-017 batch 4, 2026-09-19) ----

# The Mongo shim (lib/mongodb.ts) must have ZERO runtime importers under lib/
# and app/: all data access rides drizzle/pg directly. vi.mock sites in test
# files are exempt — they exist to keep the shim quarantined. The compat alias
# in lib/db/connection.ts (connectToDatabase -> db) and the shim module itself
# are excluded. Fail-closed on the enumeration: a grep failure must not
# impersonate a pass (same defect class as the pre-commit matcher, 2026-09-16).
echo "🔍 pre-push: Mongo shim runtime census (zero runtime importers)..."
shim_hits="$(grep -rEl "from '[^']*mongodb'" lib app --include='*.ts' 2>&1)" || {
  echo "$shim_hits" >&2
  echo "❌ pre-push: shim census enumeration failed (grep exit $?) — refusing the push" >&2
  exit 2
}
shim_hits="$(printf '%s' "$shim_hits" | grep -v "__tests__" | grep -v "\.test\." | grep -vE "lib/(mongodb|db/connection)\.ts" || true)"
if [ -n "$shim_hits" ]; then
  echo "$shim_hits" | sed 's/^/    /' >&2
  echo "❌ pre-push: runtime Mongo-shim importer(s) found above — route them" >&2
  echo "   through drizzle/pg (FID-20260917-017) before pushing." >&2
  exit 1
fi
echo "✅ pre-push: shim census clean (0 runtime importers)"

# ---- Gate 2: agent-attribution watermark scan (ported contract) ----

ZERO_SHA="0000000000000000000000000000000000000000"

watermark_lines() {
  # $1 = commit message text (from git log). Matches the commit-msg guard:
  # Codebuff / CommandCodeBot co-author trailers + Generated with/by lines.
  printf '%s' "$1" | grep -Ei '^[[:space:]]*(co-authored-by:[[:space:]].*(commandcodebot|commandcode[.]ai|codebuff)|(generated with|generated by)[[:space:]]+codebuff)' || true
}

# Git invokes the pre-push hook with one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
violations=0
while read -r localRef localSha remoteRef remoteSha; do
  [ -n "$localSha" ] || continue
  [ "$localSha" = "$ZERO_SHA" ] && continue # ref deletion — nothing to scan

  if [ "$remoteSha" = "$ZERO_SHA" ] || [ -z "$remoteSha" ]; then
    # New ref: scan commits since the merge-base with origin/HEAD, or all.
    base="$(git merge-base "$localSha" origin/HEAD 2>/dev/null || true)"
    if [ -n "$base" ]; then
      range="${base}..${localSha}"
    else
      range="$localSha"
    fi
  else
    range="${remoteSha}..${localSha}"
  fi

  echo "🔍 pre-push: scanning ${range} for unauthorized agent attribution..."
  # Fail-closed enumeration (hardened 2026-09-16): a rev-list failure used to be
  # swallowed by 2>/dev/null, leaving violations=0 — a scan error printed the
  # green 'clean' line and exited 0 (same defect class as the pre-commit gate's
  # matcher: tool failure impersonating a pass). Empty output with exit 0 is the
  # legitimate zero-commits case and still passes.
  commit_list="$(git rev-list --reverse "$range")"
  revlist_status=$?
  if [ "$revlist_status" -ne 0 ]; then
    echo "❌ pre-push: cannot enumerate ${range} (git rev-list exit ${revlist_status}) — refusing the push" >&2
    exit 2
  fi
  for sha in $commit_list; do
    message="$(git log -1 --format=%B "$sha")"
    log_status=$?
    if [ "$log_status" -ne 0 ]; then
      echo "❌ pre-push: cannot read message of ${sha} (git log exit ${log_status}) — refusing the push" >&2
      exit 2
    fi
    hits="$(watermark_lines "$message")"
    if [ -n "$hits" ]; then
      echo "❌ pre-push: commit ${sha} carries a disallowed agent watermark:" >&2
      echo "$hits" | sed 's/^/    /' >&2
      violations=$((violations + 1))
    fi
  done
done

if [ "$violations" -gt 0 ]; then
  echo "❌ pre-push: ${violations} watermarked commit(s) refused — rewrite history" >&2
  echo "   (git rebase / filter) to remove the attribution before pushing," >&2
  echo "   or push with --no-verify only when explicitly authorized." >&2
  exit 1
fi

echo "✅ pre-push: attribution scan clean"
exit 0
