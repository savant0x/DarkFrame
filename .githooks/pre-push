#!/usr/bin/env bash
# Pre-push hook — fail-closed watermark scan over the exact pushed commit
# range. Ported from savant-code (FID-20260909-036).
#
# GitHub converts Co-Authored-By trailers into contributor credit, so any
# commit message carrying an unauthorized coding-agent trailer must never
# reach the remote — even from a clone that bypassed commit-msg with
# --no-verify. The scan runs per-commit across the pushed range and refuses
# the push on the first watermarked message.
#
# This repo's node/npm toolchain is used instead of savant-code's bun gates:
# the watermark scan is pure git + grep, so it stays fail-closed without
# requiring a runtime dependency. (Secret/credential scanning per-push can be
# layered on later; the attribution guard is the ported contract.)

set -uo pipefail

ZERO_SHA="0000000000000000000000000000000000000000"

watermark_lines() {
  # $1 = commit message text (from git log). Matches the commit-msg guard:
  # Codebuff / CommandCodeBot co-author trailers + Generated with/by lines.
  printf '%s' "$1" | grep -Ei '^[[:space:]]*(co-authored-by:[[:space:]].*(commandcodebot|commandcode[.]ai|codebuff)|(generated with|generated by)[[:space:]]+codebuff)' || true
}

# Git invokes the pre-push hook with one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
violations=0
while read -r localRef localSha remoteRef remoteSha; do
  [ -n "$localSha" ] || continue
  [ "$localSha" = "$ZERO_SHA" ] && continue # ref deletion — nothing to scan

  if [ "$remoteSha" = "$ZERO_SHA" ] || [ -z "$remoteSha" ]; then
    # New ref: scan commits since the merge-base with origin/HEAD, or all.
    base="$(git merge-base "$localSha" origin/HEAD 2>/dev/null || true)"
    if [ -n "$base" ]; then
      range="${base}..${localSha}"
    else
      range="$localSha"
    fi
  else
    range="${remoteSha}..${localSha}"
  fi

  echo "🔍 pre-push: scanning ${range} for unauthorized agent attribution..."
  for sha in $(git rev-list --reverse "$range" 2>/dev/null); do
    message="$(git log -1 --format=%B "$sha" 2>/dev/null || true)"
    hits="$(watermark_lines "$message")"
    if [ -n "$hits" ]; then
      echo "❌ pre-push: commit ${sha} carries a disallowed agent watermark:" >&2
      echo "$hits" | sed 's/^/    /' >&2
      violations=$((violations + 1))
    fi
  done
done

if [ "$violations" -gt 0 ]; then
  echo "❌ pre-push: ${violations} watermarked commit(s) refused — rewrite history" >&2
  echo "   (git rebase / filter) to remove the attribution before pushing," >&2
  echo "   or push with --no-verify only when explicitly authorized." >&2
  exit 1
fi

echo "✅ pre-push: attribution scan clean"
exit 0
